+import { describe, expect, test } from "bun:test"
+import { isSvgLanguage, normalizeSvgSource, svgTitle } from "./markdown-svg-source"
+
+describe("markdown svg", () => {
+  test("recognises svg fences regardless of case or padding", () => {
+    expect(isSvgLanguage("svg")).toBe(true)
+    expect(isSvgLanguage(" SVG ")).toBe(true)
+    expect(isSvgLanguage("xml")).toBe(false)
+    expect(isSvgLanguage(undefined)).toBe(false)
+  })
+
+  test("reads the title while the rest of the diagram is still streaming", () => {
+    expect(svgTitle('<svg viewBox="0 0 10 10"><title>Double slit &amp; screen</title><rect')).toBe(
+      "Double slit & screen",
+    )
+    expect(svgTitle('<svg viewBox="0 0 10 10"><title>Unfinished')).toBeUndefined()
+    expect(svgTitle("<svg><title>  spaced\n  out </title></svg>")).toBe("spaced out")
+  })
+
+  test("adds the namespaces a standalone svg document needs", () => {
+    expect(normalizeSvgSource('<svg viewBox="0 0 1 1"></svg>')).toBe(
+      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1 1"></svg>',
+    )
+    expect(normalizeSvgSource('<svg xmlns="http://www.w3.org/2000/svg"><use xlink:href="#a"/></svg>')).toBe(
+      '<svg xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg"><use xlink:href="#a"/></svg>',
+    )
+  })
+
+  test("leaves an already valid document untouched", () => {
+    const source = '<?xml version="1.0"?>\n<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1 1"/>'
+    expect(normalizeSvgSource(source)).toBe(source)
+  })
+
+  test("rewrites html entities that xml does not define", () => {
+    expect(normalizeSvgSource('<svg xmlns="x"><text>a&nbsp;&rarr;&mdash;b &amp; &Omega;</text></svg>')).toBe(
+      '<svg xmlns="x"><text>a&#160;&#8594;&#8212;b &amp; &Omega;</text></svg>',
+    )
+  })
+})
diff --git a/packages/session-ui/src/components/markdown-svg-source.ts b/packages/session-ui/src/components/markdown-svg-source.ts
new file mode 100644
index 0000000..7452a29
--- /dev/null
+++ b/packages/session-ui/src/components/markdown-svg-source.ts
@@ -0,0 +1,139 @@
+const SVG_NS = "http://www.w3.org/2000/svg"
+const XLINK_NS = "http://www.w3.org/1999/xlink"
+const MAX_SOURCE_LENGTH = 1_000_000
+
+// Elements that can execute code or embed foreign documents. The diagram is rendered through
+// <img>, which already refuses to run them, but the source is also what users copy.
+const BLOCKED_ELEMENTS = new Set(["script", "foreignobject", "iframe", "object", "embed", "audio", "video"])
+
+// HTML named entities models routinely emit. They are not defined in XML, so a single `&nbsp;`
+// would otherwise make the whole diagram fail to parse.
+const HTML_ENTITIES: Record<string, string> = {
+  nbsp: "#160",
+  ndash: "#8211",
+  mdash: "#8212",
+  hellip: "#8230",
+  times: "#215",
+  divide: "#247",
+  deg: "#176",
+  middot: "#183",
+  bull: "#8226",
+  larr: "#8592",
+  uarr: "#8593",
+  rarr: "#8594",
+  darr: "#8595",
+  harr: "#8596",
+  plusmn: "#177",
+  le: "#8804",
+  ge: "#8805",
+  ne: "#8800",
+  micro: "#181",
+  copy: "#169",
+}
+
+export function isSvgLanguage(language: string | undefined) {
+  return language?.trim().toLowerCase() === "svg"
+}
+
+function decodeText(text: string) {
+  return text
+    .replace(/&#x([0-9a-f]+);/gi, (_, hex: string) => String.fromCodePoint(Number.parseInt(hex, 16)))
+    .replace(/&#(\d+);/g, (_, dec: string) => String.fromCodePoint(Number(dec)))
+    .replace(/&lt;/g, "<")
+    .replace(/&gt;/g, ">")
+    .replace(/&quot;/g, '"')
+    .replace(/&apos;/g, "'")
+    .replace(/&amp;/g, "&")
+}
+
+/** The first `<title>`, readable as soon as it has streamed in, so the loader can say what is being drawn. */
+export function svgTitle(source: string) {
+  const text = source
+    .match(/<title\b[^>]*>([^<]{1,200})<\/title>/i)?.[1]
+    ?.replace(/\s+/g, " ")
+    .trim()
+  if (!text) return undefined
+  return decodeText(text)
+}
+
+/** String-level repairs so typical model output parses as a standalone SVG document. */
+export function normalizeSvgSource(source: string) {
+  const text = source.trim().replace(/&([a-z]+);/gi, (entity, name: string) => {
+    const code = HTML_ENTITIES[name.toLowerCase()]
+    return code ? `&${code};` : entity
+  })
+  const open = text.match(/<svg\b[^>]*>/i)
+  if (!open || open.index === undefined) return text
+  let tag = open[0]
+  if (!/\sxmlns\s*=/.test(tag)) tag = tag.replace(/^<svg\b/i, `<svg xmlns="${SVG_NS}"`)
+  if (/\bxlink:/.test(text) && !/\sxmlns:xlink\s*=/.test(tag))
+    tag = tag.replace(/^<svg\b/i, `<svg xmlns:xlink="${XLINK_NS}"`)
+  return text.slice(0, open.index) + tag + text.slice(open.index + open[0].length)
+}
+
+function safeHref(value: string) {
+  const href = value.trim()
+  return href.startsWith("#") || /^data:image\/(?:png|jpe?g|gif|webp);/i.test(href)
+}
+
+function length(value: string | null) {
+  const match = value?.match(/^\s*(\d+(?:\.\d+)?)\s*(?:px)?\s*$/)
+  if (!match) return undefined
+  const result = Number(match[1])
+  return result > 0 ? result : undefined
+}
+
+export type PreparedSvg = {
+  url: string
+  width?: number
+  height?: number
+  title?: string
+}
+
+/**
+ * Validates, strips and sizes an SVG so it can be shown through `<img>`. An image context never
+ * runs scripts or fetches remote resources, and keeps the diagram's `<style>` and ids from
+ * leaking into (or colliding with) the rest of the transcript.
+ */
+export function prepareSvg(source: string, color?: string): PreparedSvg | undefined {
+  if (!source.trim() || source.length > MAX_SOURCE_LENGTH) return undefined
+  if (typeof DOMParser === "undefined" || typeof XMLSerializer === "undefined") return undefined
+
+  const doc = new DOMParser().parseFromString(normalizeSvgSource(source), "image/svg+xml")
+  const root = doc.documentElement
+  if (!root || root.namespaceURI !== SVG_NS || root.localName !== "svg") return undefined
+  if (doc.getElementsByTagNameNS("*", "parsererror").length > 0) return undefined
+
+  for (const element of [root, ...Array.from(root.querySelectorAll("*"))]) {
+    if (BLOCKED_ELEMENTS.has(element.localName.toLowerCase())) {
+      element.remove()
+      continue
+    }
+    for (const attribute of Array.from(element.attributes)) {
+      const name = attribute.name.toLowerCase()
+      if (name.startsWith("on")) element.removeAttributeNode(attribute)
+      else if ((name === "href" || name === "xlink:href") && !safeHref(attribute.value))
+        element.removeAttributeNode(attribute)
+    }
+  }
+
+  // <img> needs an absolute size; percentage or missing dimensions fall back to the viewBox.
+  const [, , boxWidth = 0, boxHeight = 0, ...rest] = (root.getAttribute("viewBox") ?? "")
+    .trim()
+    .split(/[\s,]+/)
+    .map(Number)
+  const validBox = rest.length === 0 && boxWidth > 0 && boxHeight > 0
+  const viewWidth = validBox ? boxWidth : undefined
+  const viewHeight = validBox ? boxHeight : undefined
+  const width = length(root.getAttribute("width")) ?? viewWidth
+  const height = length(root.getAttribute("height")) ?? viewHeight
+  if (width && length(root.getAttribute("width")) === undefined) root.setAttribute("width", String(width))
+  if (height && length(root.getAttribute("height")) === undefined) root.setAttribute("height", String(height))
+
+  // Lets `currentColor` follow the transcript's text color even though the image is isolated.
+  if (color && !root.hasAttribute("color")) root.setAttribute("color", color)
+
+  const title = root.querySelector("title")?.textContent?.replace(/\s+/g, " ").trim() || undefined
+  const markup = new XMLSerializer().serializeToString(root)
+  return { url: `data:image/svg+xml;charset=utf-8,${encodeURIComponent(markup)}`, width, height, title }
+}
diff --git a/packages/session-ui/src/components/markdown-svg.tsx b/packages/session-ui/src/components/markdown-svg.tsx
new file mode 100644
index 0000000..9a95909
--- /dev/null
+++ b/packages/session-ui/src/components/markdown-svg.tsx
@@ -0,0 +1,161 @@
+import { createMemo, createSignal, onMount, Show, type Accessor, type Setter } from "solid-js"
+import { render } from "solid-js/web"
+import { Spinner } from "@opencode-ai/ui/spinner"
+import { TextShimmer } from "@opencode-ai/ui/text-shimmer"
+import { Icon as IconV2 } from "@opencode-ai/ui/v2/icon"
+import { IconButtonV2 } from "@opencode-ai/ui/v2/icon-button-v2"
+import { TooltipV2 } from "@opencode-ai/ui/v2/tooltip-v2"
+import { SessionProgressIndicatorV2 } from "../v2/components/session-progress-indicator-v2"
+import { prepareSvg, svgTitle } from "./markdown-svg-source"
+
+export type SvgLabels = {
+  copy: string
+  copied: string
+  loading: string
+  error: string
+  alt: string
+}
+
+export type SvgProps = {
+  source: string
+  complete: boolean
+  labels: SvgLabels
+}
+
+function MarkdownSvg(props: { state: Accessor<SvgProps> }) {
+  let frame: HTMLDivElement | undefined
+  const [color, setColor] = createSignal<string>()
+  const [copied, setCopied] = createSignal(false)
+  const newLayout = typeof document !== "undefined" && document.body.hasAttribute("data-new-layout")
+  const source = createMemo(() => props.state().source)
+  const complete = createMemo(() => props.state().complete)
+  const labels = () => props.state().labels
+  const title = createMemo(() => svgTitle(source()))
+  const prepared = createMemo(() => {
+    const value = color()
+    if (!complete() || value === undefined) return undefined
+    return prepareSvg(source(), value)
+  })
+  let reset: ReturnType<typeof setTimeout> | undefined
+
+  // The host is attached right after render(), so resolve the inherited colour on the next tick.
+  onMount(() => queueMicrotask(() => setColor((frame && getComputedStyle(frame).color) || "#888888")))
+
+  const copy = async () => {
+    const clipboard = typeof navigator === "undefined" ? undefined : navigator.clipboard
+    if (!clipboard) return
+    await clipboard.writeText(source())
+    setCopied(true)
+    if (reset) clearTimeout(reset)
+    reset = setTimeout(() => setCopied(false), 2000)
+  }
+
+  const copyButton = () => {
+    const label = () => (copied() ? labels().copied : labels().copy)
+    return (
+      <div data-slot="markdown-svg-copy" data-copied={copied() ? "true" : undefined}>
+        <TooltipV2 placement="top" value={label()}>
+          <IconButtonV2
+            type="button"
+            size="normal"
+            variant="ghost-muted"
+            aria-label={label()}
+            onClick={() => void copy()}
+            icon={<IconV2 name={copied() ? "check" : "outline-copy"} />}
+          />
+        </TooltipV2>
+      </div>
+    )
+  }
+
+  return (
+    <div ref={frame} data-slot="markdown-svg-frame">
+      <Show
+        when={complete()}
+        fallback={
+          <div data-slot="markdown-svg-loading" role="status" aria-live="polite">
+            <span data-slot="markdown-svg-spinner">
+              <Show when={newLayout} fallback={<Spinner />}>
+                <SessionProgressIndicatorV2 />
+              </Show>
+            </span>
+            <TextShimmer text={title() ?? labels().loading} />
+          </div>
+        }
+      >
+        <Show when={color() !== undefined}>
+          <Show
+            when={prepared()}
+            fallback={
+              <div data-slot="markdown-svg-error">
+                <div data-slot="markdown-svg-error-message">{labels().error}</div>
+                <pre class="shiki OpenCode">
+                  <code>{source()}</code>
+                </pre>
+                {copyButton()}
+              </div>
+            }
+          >
+            {(svg) => (
+              <figure data-slot="markdown-svg-figure">
+                <img
+                  data-slot="markdown-svg-image"
+                  src={svg().url}
+                  alt={svg().title ?? title() ?? labels().alt}
+                  width={svg().width}
+                  height={svg().height}
+                  draggable={false}
+                />
+                {copyButton()}
+              </figure>
+            )}
+          </Show>
+        </Show>
+      </Show>
+    </div>
+  )
+}
+
+type SvgHostState = {
+  set: Setter<SvgProps>
+  dispose: () => void
+}
+
+const svgHosts = new WeakMap<HTMLElement, SvgHostState>()
+
+export function createSvgHost() {
+  const host = document.createElement("div")
+  host.setAttribute("data-component", "markdown-svg")
+  return host
+}
+
+export function isSvgHost(node: Node): node is HTMLElement {
+  return node instanceof HTMLElement && node.getAttribute("data-component") === "markdown-svg"
+}
+
+/** Mounts the diagram into `host` on first call and updates it in place afterwards. */
+export function updateSvgHost(host: HTMLElement, props: SvgProps) {
+  const existing = svgHosts.get(host)
+  if (existing) {
+    existing.set(props)
+    return
+  }
+  const state: Partial<SvgHostState> = {}
+  state.dispose = render(() => {
+    const [value, set] = createSignal(props)
+    state.set = set
+    return <MarkdownSvg state={value} />
+  }, host)
+  svgHosts.set(host, state as SvgHostState)
+}
+
+export function disposeSvgHosts(root: Element) {
+  const hosts = [
+    ...(isSvgHost(root) ? [root] : []),
+    ...Array.from(root.querySelectorAll('[data-component="markdown-svg"]')).filter(isSvgHost),
+  ]
+  for (const host of hosts) {
+    svgHosts.get(host)?.dispose()
+    svgHosts.delete(host)
+  }
+}
